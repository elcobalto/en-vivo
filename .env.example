## Local-only environment variables (copy to ".env")
#
# Never commit your real ".env" file.

# Setlist.fm API key (required for /setlistfm/)
SETLISTFM_API_KEY="paste_your_key_here"


# Google login (required for "Continue with Google")
# Create an OAuth client (type: Web application) in Google Cloud Console.
# Authorized redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID="paste_your_client_id_here"
GOOGLE_CLIENT_SECRET="paste_your_client_secret_here"
