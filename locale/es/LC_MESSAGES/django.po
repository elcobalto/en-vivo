msgstr "Algo salió mal al importar ese setlist. No se guardó nada."

#: events/views.py:1273
#, python-format
msgid "Imported %(n)s song for %(artist)s."
msgid_plural "Imported %(n)s songs for %(artist)s."
msgstr[0] "Se importó %(n)s canción de %(artist)s."
msgstr[1] "Se importaron %(n)s canciones de %(artist)s."

#: events/views.py:1288
msgid "Pick a date."
msgstr "Elige una fecha."

#: events/views.py:1292
#, python-format
msgid "Added %(date)s. Edit it if anything is different that day."
msgstr "Se agregó el %(date)s. Edítalo si algo cambia ese día."

#: events/views.py:1295
msgid "The show already has that date."
msgstr "El espectáculo ya tiene esa fecha."

#: events/views_admin.py:50 events/views_admin.py:153
msgid "Pick an artist first."
msgstr "Primero elige un artista."

#: events/views_admin.py:55
#, python-format
msgid "There's already an unfinished import for %(name)s."
msgstr "Ya hay una importación sin terminar de %(name)s."

#: events/views_admin.py:121 events/views_merge.py:206
msgid "Give the festival a name."
msgstr "Ponle un nombre al festival."

#: events/views_admin.py:124
#, python-format
msgid "“%(event)s” is now a festival day of %(name)s."
msgstr "“%(event)s” ahora es un día del festival %(name)s."

#: events/views_bulk.py:62
msgid "Needs at least a date and an event name."
msgstr "Necesita al menos una fecha y un nombre de evento."

#: events/views_bulk.py:67
#, python-format
msgid "Couldn't read the date “%(date)s” (use 2019-03-20 or 20-03-2019)."
msgstr "No se pudo leer la fecha “%(date)s” (usa 2019-03-20 o 20-03-2019)."

#: events/views_bulk.py:74
#, python-format
msgid "Unknown type “%(type)s” (music, theater, comedy, dance, festival, other)."
msgstr "Tipo desconocido “%(type)s” (música, teatro, comedia, danza, festival, otro)."

#: events/views_bulk.py:101
#, python-format
msgid "%(created)s, %(existing)s. Now add venues and lineups."
msgstr "%(created)s, %(existing)s. Ahora agrega los recintos y line-ups."

#: events/views_bulk.py:102 events/views_venues.py:150
#, python-format
msgid "%(n)s event created"
msgid_plural "%(n)s events created"
msgstr[0] "%(n)s evento creado"
msgstr[1] "%(n)s eventos creados"

#: events/views_bulk.py:103
#, python-format
msgid "%(n)s already existed"
msgid_plural "%(n)s already existed"
msgstr[0] "%(n)s ya existía"
msgstr[1] "%(n)s ya existían"

#: events/views_bulk.py:105
#, python-format
msgid "%(n)s event created. Now add venues and lineups."
msgid_plural "%(n)s events created. Now add venues and lineups."
msgstr[0] "%(n)s evento creado. Ahora agrega los recintos y line-ups."
msgstr[1] "%(n)s eventos creados. Ahora agrega los recintos y line-ups."

#: events/views_bulk.py:157
#, python-format
msgid "Updated %(n)s event."
msgid_plural "Updated %(n)s events."
msgstr[0] "Se actualizó %(n)s evento."
msgstr[1] "Se actualizaron %(n)s eventos."

#: events/views_discovery.py:45
msgid "Want to go is only for upcoming events."
msgstr "Quiero ir es solo para eventos próximos."

#: events/views_discovery.py:48
msgid "Added to your Want to go."
msgstr "Se agregó a tu lista Quiero ir."

#: events/views_discovery.py:50
msgid "Removed from your Want to go."
msgstr "Se quitó de tu lista Quiero ir."

#: events/views_discovery.py:109
msgid "List saved."
msgstr "Lista guardada."

#: events/views_discovery.py:119
#, python-format
msgid "Deleted list “%(title)s”."
msgstr "Se eliminó la lista “%(title)s”."

#: events/views_discovery.py:137
#, python-format
msgid "Already in “%(title)s”."
msgstr "Ya está en “%(title)s”."

#: events/views_discovery.py:147
#, python-format
msgid "Added to “%(title)s”."
msgstr "Se agregó a “%(title)s”."

#: events/views_feedback.py:31
msgid "You've sent a lot of feedback in the last hour; please try again later."
msgstr "Enviaste muchos comentarios en la última hora; inténtalo de nuevo más tarde."

#: events/views_feedback.py:42
msgid "Thanks! Your message reached the En Vivo team."
msgstr "¡Gracias! Tu mensaje le llegó al equipo de En Vivo."

#: events/views_merge.py:77
msgid "Unknown action."
msgstr "Acción desconocida."

#: events/views_merge.py:86
#, python-format
msgid "Merged into one festival: “%(title)s”."
msgstr "Se fusionaron en un solo festival: “%(title)s”."

#: events/views_merge.py:88
#, python-format
msgid "“%(support)s” is now the support act on “%(title)s”."
msgstr "“%(support)s” ahora es el telonero de “%(title)s”."

#: events/views_merge.py:101
#, python-format
msgid "Got it: “%(one)s” and “%(other)s” are separate shows."
msgstr "Entendido: “%(one)s” y “%(other)s” son shows distintos."

#: events/views_merge.py:161
#, python-format
msgid "Grouped %(n)s days as “%(title)s”."
msgstr "Se agruparon %(n)s días como “%(title)s”."

#: events/views_merge.py:218
#, python-format
msgid "“%(title)s” already had an event that day, so this was merged into it."
msgstr "“%(title)s” ya tenía un evento ese día, así que este se fusionó con él."

#: events/views_merge.py:221
#, python-format
msgid "“%(title)s” is now part of the festival “%(festival)s”."
msgstr "“%(title)s” ahora es parte del festival “%(festival)s”."

#: events/views_merge.py:238
#, python-format
msgid "“%(title)s” was added to “%(kept)s”."
msgstr "“%(title)s” se agregó a “%(kept)s”."

#: events/views_merge.py:281
#, python-format
msgid "Merged “%(removed)s” into “%(kept)s”."
msgstr "Se fusionó “%(removed)s” con “%(kept)s”."

#: events/views_merge.py:297
#, python-format
msgid "Merged the duplicate “%(removed)s” into this event."
msgstr "Se fusionó el duplicado “%(removed)s” con este evento."

#: events/views_social.py:235
msgid "Profile saved."
msgstr "Perfil guardado."

#: events/views_social.py:257
msgid "Favourites saved."
msgstr "Favoritos guardados."

#: events/views_social.py:291
msgid "You can't follow yourself."
msgstr "No puedes seguirte a ti mismo."

#: events/views_social.py:368
msgid "Your reply can't be empty."
msgstr "Tu respuesta no puede estar vacía."

#: events/views_venues.py:61
msgid "Too many searches, wait a moment."
msgstr "Demasiadas búsquedas, espera un momento."

#: events/views_venues.py:75
msgid "Missing place."
msgstr "Falta el lugar."

#: events/views_venues.py:96
#, python-format
msgid "“%(name)s” now uses Google's data."
msgstr "“%(name)s” ahora usa los datos de Google."

#: events/views_venues.py:115
#, python-format
msgid "Open “%(title)s” →"
msgstr "Abrir “%(title)s” →"

#: events/views_venues.py:117
msgid "See them in the events list, latest added first →"
msgstr "Verlos en la lista de eventos, los últimos agregados primero →"

#: events/views_venues.py:128
msgid "Select at least one setlist."
msgstr "Selecciona al menos un setlist."

#: events/views_venues.py:152
#, python-format
msgid "%(n)s added to existing events"
msgstr "%(n)s agregados a eventos existentes"

#: events/views_venues.py:154
#, python-format
msgid "%(n)s already imported"
msgstr "%(n)s ya importados"

#: events/views_venues.py:156
#, python-format
msgid "%(n)s added to your diary"
msgstr "%(n)s agregados a tu diario"

#: events/views_venues.py:171
msgid "Fill in at least one filter: artist, city, venue, year or country."
msgstr "Completa al menos un filtro: artista, ciudad, recinto, año o país."

#: events/views_venues.py:214
msgid "That's a link to the search results, not to the photo. Drag the photo itself here, or right-click it → “Copy image address”."
msgstr "Ese es un enlace a los resultados de búsqueda, no a la foto. Arrastra la foto misma aquí, o haz clic derecho → “Copiar dirección de la imagen”."

#: events/views_venues.py:218
msgid "That photo can't be used (it needs a secure https link)."
msgstr "Esa foto no se puede usar (necesita un enlace https seguro)."

#: events/views_venues.py:222
msgid "Photo updated."
msgstr "Foto actualizada."

#: events/views_venues.py:236
msgid "You've searched a lot in the last hour; try again later."
msgstr "Has buscado mucho en la última hora; inténtalo más tarde."

#: events/views_venues.py:267
msgid "Pick the image that fits best: a poster, the artist, or the show itself."
msgstr "Elige la imagen que mejor calce: un afiche, el artista o el show mismo."

#: events/views_venues.py:285
msgid "Pick the festival or tour poster. It's also used for its events that have no photo."
msgstr "Elige el afiche del festival o de la gira. También se usa para sus eventos que no tienen foto."

#: events/views_venues.py:299
msgid "Pick a photo of the artist. It's also used for their events that have no photo."
msgstr "Elige una foto del artista. También se usa para sus eventos que no tienen foto."

#: events/views_venues.py:315
msgid "That doesn't look like a YouTube link."
msgstr "Eso no parece un enlace de YouTube."

#: events/views_venues.py:322
msgid "That video is already on this event."
msgstr "Ese video ya está en este evento."

#: events/views_venues.py:326
msgid "Video added."
msgstr "Video agregado."

#: events/views_venues.py:339
msgid "Video removed."
msgstr "Video eliminado."

#: events/views_venues.py:393
msgid "Only https photos from public sites can be read."
msgstr "Solo se pueden leer fotos https de sitios públicos."

#: events/views_venues.py:418
#, python-format
msgid "The photo's site answered %(code)s."
msgstr "El sitio de la foto respondió %(code)s."

#: events/views_venues.py:421
#, python-format
msgid "Couldn't download the photo (%(error)s)."
msgstr "No se pudo descargar la foto (%(error)s)."

#: events/views_venues.py:424
msgid "The photo is larger than 8 MB."
msgstr "La foto pesa más de 8 MB."

#: events/views_venues.py:428
msgid "That link isn't an image."
msgstr "Ese enlace no es una imagen."

